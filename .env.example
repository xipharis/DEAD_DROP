# ---------------------------------------------------------------------------
# Relayer daemon (apps/relayer)
# ---------------------------------------------------------------------------

# JSON-RPC endpoint the RELAYER uses. The signing browser never sees this.
RPC_URL=https://sepolia.drpc.org

# Chain the relayer is willing to broadcast to. Guards against replaying a
# transaction signed for a different network.
CHAIN_ID=11155111

# Comma-separated Nostr relays to subscribe to.
NOSTR_RELAYS=wss://relay.damus.io,wss://nos.lol,wss://relay.primal.net

# Tag that marks a note as carrying a raw Ethereum transaction.
NOSTR_TAG=ethrelay

# Refuse to broadcast transactions whose tip to the relayer is below this
# (in wei). Set to 0 to relay altruistically.
MIN_TIP_WEI=0

# Address the relayer expects to be tipped at. Optional; only used when
# MIN_TIP_WEI > 0. Only a direct transfer counts as a tip — a relayer cannot
# verify a tip routed through a contract call without simulating it.
RELAYER_ADDRESS=0x0000000000000000000000000000000000000000

# Validate and log drops without broadcasting them. Needs no RPC_URL, so it is
# the safe way to watch the swarm or rehearse a demo.
DRY_RUN=false

# ---------------------------------------------------------------------------
# Web app (apps/web) -- NEXT_PUBLIC_* is bundled into the client
# ---------------------------------------------------------------------------

NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_NOSTR_RELAYS=wss://relay.damus.io,wss://nos.lol,wss://relay.primal.net
NEXT_PUBLIC_NOSTR_TAG=ethrelay

# RPC the browser calls once, automatically, right after signing — purely to
# look up the account's real next nonce and warn if what was typed does not
# match. This is the one deliberate exception to "the signer never touches an
# RPC": signing itself still needs no network; this post-sign check does, and
# fails soft (skips the check) if unreachable.
NEXT_PUBLIC_NONCE_CHECK_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
