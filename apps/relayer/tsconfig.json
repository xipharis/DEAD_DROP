{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "types": ["node"],
    // Imports carry their real `.ts` extension so tsx/node can resolve them
    // unchanged during dev; tsc rewrites them to `.js` on the way into dist.
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": ["src"]
}
